    },
    {
      "start": 22.4433,
      "end": 23.9733,
      "text": "Das ist wahrscheinlich das"
    },
    {
      "start": 23.9833,
      "end": 24.723300000000002,
      "text": "Deutsch,"
    },
    {
      "start": 24.9433,
      "end": 26.1033,
      "text": "das du gelernt hast."
    },
    {
      "start": 26.2367,
      "end": 27.746699999999997,
      "text": "Aber ist es auch dein"
    },
    {
      "start": 27.7567,
      "end": 28.3767,
