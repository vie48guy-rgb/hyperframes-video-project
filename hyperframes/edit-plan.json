    },
    {
      "start": 7.25,
      "end": 9.690000000000001,
      "text": "sagt er oder sie ab."
    },
    {
      "start": 9.87,
      "end": 11.190000000000001,
      "text": "Wie reagierst du?"
    },
    {
      "start": 11.3167,
      "end": 13.5767,
      "text": "Du könntest zum Beispiel sagen,"
    },
    {
      "start": 13.6833,
      "end": 14.2233,
      "text": "okay,"
    },
    {
      "start": 14.7033,
      "end": 15.503300000000001,
      "text": "kein Problem,"
    },
    {
      "start": 15.9033,
      "end": 17.9033,
      "text": "vielleicht ein anderes Mal."
    },
    {
      "start": 18.3233,
      "end": 19.7433,
      "text": "Und das ist nicht schlecht,"
    },
    {
      "start": 19.8233,
      "end": 20.5833,
      "text": "das ist okay,"
    },
    {
      "start": 21.0633,
