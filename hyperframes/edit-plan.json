  "captions": [
    {
      "start": 0.23,
      "end": 1.68,
      "text": "Du möchtest mit einem Freund"
    },
    {
      "start": 1.69,
      "end": 4.05,
      "text": "oder einer Freundin Essen gehen."
    },
    {
      "start": 4.81,
